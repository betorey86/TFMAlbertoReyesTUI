# despliegue, que no puede regenerar el ETL.
!data/dashboard/
!data/dashboard/**

# Notebooks
.ipynb_checkpoints/

# Docker
pgdata/

# IDE / SO
.vscode/
.idea/
Thumbs.db
.DS_Store
