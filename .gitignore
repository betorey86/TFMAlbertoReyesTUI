# Entorno / secretos
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Datos (pueden ser grandes; se regeneran con el ETL)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
