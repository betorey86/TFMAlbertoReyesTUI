# Plantilla de configuración. Copiar a .env y pegar la cadena real de Railway.
#
# En Railway: proyecto > servicio Postgres > pestaña "Variables" > DATABASE_PUBLIC_URL
# (usa la PÚBLICA, no la interna: la interna sólo resuelve dentro de la red de Railway
# y no funciona desde tu máquina).
#
# Formato: postgresql://usuario:password@host:puerto/base_de_datos

DATABASE_URL=postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway
